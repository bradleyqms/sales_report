# Environment variables for Sales Report application

# ============================================================================
# DATABASE CONFIGURATION (Azure AD Authentication - No Password Needed!)
# ============================================================================

# Azure SQL Server connection details
DATABASE_SERVER=dnr-sql-server-qmsmedicosmetics.database.windows.net
DATABASE_NAME=dnr-mapping-db

# Authentication: Uses Azure AD (no password!)
# - Production: Managed Identity (automatic when deployed to Azure)
# - Local: Azure CLI (run 'az login' first)

# SQL query logging (set to 'true' for debugging)
SQL_ECHO=false

# ============================================================================
# AZURE AD / GRAPH API (existing - for SharePoint)
# ============================================================================
GRAPH_TENANT_ID=your_tenant_id
GRAPH_CLIENT_ID=your_client_id
GRAPH_CLIENT_SECRET=your_client_secret

# ============================================================================
# SHAREPOINT (existing)
# ============================================================================
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/yoursite
SHAREPOINT_FOLDER_PATH=Shared Documents/Reports

# ============================================================================
# APPLICATION SETTINGS (existing)
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# Admin emails for access control (comma-separated)
ADMIN_EMAILS=bradley@qmsmedicosmetics.com,admin@example.com

# ============================================================================
# HUB ACCESS CONTROL (Phase 4 — Azure Easy Auth + SSO)
# ============================================================================
# Each var is a comma-separated list of email addresses (case-insensitive).
# Azure Easy Auth (portal) injects X-MS-CLIENT-PRINCIPAL-NAME before FastAPI
# sees the request; these frozensets are parsed ONCE at startup.

# Super Admin — all pages + Admin UI + Usage Dashboard
HUB_ADMIN_EMAILS=bradley@qmsmedicosmetics.com

# Global Viewer — /coremarkets + /usaspa, no Admin UI
HUB_MANAGEMENT_EMAILS=

# Segment — /coremarkets only
HUB_CORE_EMAILS=

# Segment — /usaspa only
HUB_USA_EMAILS=

# Local dev fallback (used when X-MS-CLIENT-PRINCIPAL-NAME header is absent)
# Set this to your own email to bypass Easy Auth locally.
DEV_USER_EMAIL=bradley@qmsmedicosmetics.com
