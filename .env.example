# Environment variables for Sales Report application

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Azure SQL Server connection details
DATABASE_SERVER=dnr-sql-server-qmsmedicosmetics.database.windows.net
DATABASE_NAME=dnr-mapping-db

# Local development: SQL authentication (not used in production)
DATABASE_USER=sqladmin
DATABASE_PASSWORD=your_sql_password_here

# Alternative: Full connection string for local dev
# DATABASE_URL_LOCAL=mssql+pyodbc://sqladmin:your_password@dnr-sql-server-qmsmedicosmetics.database.windows.net/dnr-mapping-db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes

# SQL query logging (set to 'true' for debugging)
SQL_ECHO=false

# ============================================================================
# AZURE AD / GRAPH API (existing - for SharePoint)
# ============================================================================
GRAPH_TENANT_ID=your_tenant_id
GRAPH_CLIENT_ID=your_client_id
GRAPH_CLIENT_SECRET=your_client_secret

# ============================================================================
# SHAREPOINT (existing)
# ============================================================================
SHAREPOINT_SITE_URL=https://yourcompany.sharepoint.com/sites/yoursite
SHAREPOINT_FOLDER_PATH=Shared Documents/Reports

# ============================================================================
# APPLICATION SETTINGS (existing)
# ============================================================================
ENVIRONMENT=development
DEBUG=true

# Admin emails for access control (comma-separated)
ADMIN_EMAILS=bradley@qmsmedicosmetics.com,admin@example.com
